# Скопируйте в docker-compose.override.yml — compose читает его сам,
# дополнительных ключей не нужно. Файл в .gitignore: сюда идёт всё, что
# зависит от конкретного хоста, а docker-compose.yml остаётся общим.

services:
  leauth-proxy:
    # Порты сверх PROXY_PORT — по одному на каждый listen из agent.yaml.
    # Списки портов из двух файлов складываются, а не замещают друг друга.
    ports:
      - "9443:9443"

    # Бэкенд, поднятый другим compose-проектом или ansible, живёт в своей
    # сети, и прокси его не видит. Подключение к этой сети даёт резолв по
    # имени контейнера: upstream: http://backend:8080. Публиковать порт
    # бэкенда на хост при этом не нужно.
    #
    # default перечислен явно: без него сервис выпадет из своей сети.
    networks:
      - default
      - backend

networks:
  backend:
    external: true
    # Имя сети в docker, если оно отличается от ключа выше.
    # Посмотреть: docker network ls
    # name: чужой-проект_backend
