server: https://leauth.example.com

# Имя этого прокси в центре. Необязательно: по умолчанию имя хоста.
# name: srv-01

# Общий токен приёма. Нужен только при первом запуске: центр выдаёт
# прокси персональный токен, тот сохраняется в cert_dir и переживает
# пересоздание контейнера.
enroll_token: ${LEAUTH_ENROLL_TOKEN}

cert_dir: /etc/leauth/certs
# Как часто прокси спрашивает центр. Пока хоть один домен сидит на
# самоподписанной заглушке, опрос идёт раз в минуту независимо от этого
# значения — чтобы выпущенный сертификат не ждал конца часа.
poll_interval: 1h

# DNS для резолва апстримов внутри nginx.
# 127.0.0.11 — встроенный DNS Docker, менять нужно редко.
resolver: 127.0.0.11

# Зоны, на которые заказывается один сертификат с *.<зона>. Все
# эндпоинты внутри зоны используют его, поэтому CNAME прописывается
# один раз на зону, а не на каждый домен. Wildcard покрывает один
# уровень: под *.example.com подпадает docs.example.com, но не
# a.docs.example.com. Без этого списка сертификат заказывается на
# каждый домен отдельно — и CNAME тоже.
# wildcard_zones:
#   - example.com

# Реквизиты GitLab. Нужны, только если хотя бы у одного эндпоинта есть
# блок oauth. В GitLab заводится одно приложение, в нём перечисляются
# redirect URI всех закрытых доменов.
# oauth:
#   issuer: https://gitlab.example.com
#   client_id: ${GITLAB_CLIENT_ID}
#   client_secret: ${GITLAB_CLIENT_SECRET}
#   cookie_secret: ${OAUTH_COOKIE_SECRET}
#
#   # Общий вход. Без него у каждого закрытого домена свой процесс
#   # oauth2-proxy и своя строка redirect URI в GitLab — то есть каждый
#   # новый домен требует правки приложения GitLab.
#   #
#   # С ним вход для всех закрытых доменов идёт через один домен, процесс
#   # один, а в GitLab остаётся одна строка навсегда:
#   #   https://auth.example.com:8443/oauth2/callback
#   #
#   # Домен входа объявляется обычным эндпоинтом (см. ниже), а все
#   # закрытые домены обязаны лежать под общим родительским доменом —
#   # сессионная cookie ставится на него. Группы у эндпоинтов работают
#   # как обычно.
#   auth_domain: auth.example.com

# Домены на одном порту различаются по SNI, поэтому listen у всех
# эндпоинтов может быть одинаковым — публиковать придётся один порт.
endpoints:
  - domain: foo.example.com
    listen: 8443
    upstream: http://app:3000

  # Закрыт членам перечисленных групп GitLab. Группа пишется полным
  # путём, вложенные подгруппы — через слеш.
  # - domain: docs.example.com
  #   listen: 8443
  #   upstream: http://docs:8080
  #   oauth:
  #     groups: [platform/backend, platform/sre]

  # upstream_auth — реквизиты для бэкенда с собственной basic-защитой.
  # Прокси подставляет их сам, поэтому снаружи вход решает GitLab, а
  # пароль приложения остаётся внутри. Клиентский заголовок при этом
  # сохраняется: если он пришёл, подстановки не будет.
  # - domain: prom.example.com
  #   listen: 8443
  #   upstream: http://metrics:9090
  #   upstream_auth:
  #     user: admin
  #     password: ${PROM_PASSWORD}
  #   oauth:
  #     groups: [platform/sre]

  # skip_paths выводят префиксы из-под авторизации. Нужны там, где по
  # одному адресу живут страница для человека и машинный интерфейс:
  # браузерный вход клиент с токеном не переживёт.
  # - domain: leauth.example.com
  #   listen: 8443
  #   upstream: http://127.0.0.1:8080
  #   oauth:
  #     groups: [platform/sre]
  #     skip_paths: [/api/]

  # Пустой блок oauth пускает любого, кто вошёл в GitLab.
  # external_url нужен, когда снаружи домен доступен на другом порту:
  # адрес обязан совпадать с redirect URI, записанным в GitLab.
  # - domain: wiki.example.com
  #   listen: 8443
  #   upstream: http://wiki:8080
  #   external_url: https://wiki.example.com
  #   oauth: {}

  # Домен входа для oauth.auth_domain. Обычный эндпоинт: ему нужен свой
  # сертификат и CNAME, а снаружи запрашиваются только пути /oauth2/,
  # поэтому upstream может указывать куда угодно. Закрывать его блоком
  # oauth не нужно.
  # - domain: auth.example.com
  #   listen: 8443
  #   upstream: http://заглушка:80
