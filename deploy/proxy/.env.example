# Скопируйте в .env и заполните. Файл читается docker compose автоматически.

# Версия образа из ghcr.io/wendor/leauth-proxy. По умолчанию latest; на
# боевом хосте лучше закрепить релиз — тот же, что и на центре.
# LEAUTH_TAG=v1.0.0

# Общий токен приёма, выдаётся администратором центра. Нужен только при
# первом запуске: дальше прокси ходит с персональным токеном, который
# лежит в томе с сертификатами и переживает пересоздание контейнера.
LEAUTH_ENROLL_TOKEN=

# Порт, публикуемый на хост. Должен совпадать с listen эндпоинтов в
# agent.yaml. Домены различаются по SNI, поэтому одного порта хватает на
# любое их количество; если портов всё же несколько, остальные
# добавляются в docker-compose.override.yml.
# PROXY_PORT=8443

# Дальше — только для эндпоинтов с блоком oauth.

# Application ID и Secret приложения в GitLab. Секрет показывается один
# раз при создании приложения.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Шифрует сессионную cookie, 16, 24 или 32 байта:
#   openssl rand -base64 32 | tr -- '+/' '-_'
# tr обязателен: oauth2-proxy читает секрет только как base64url, и
# строка с "+" или "/" доедет до него сырыми 44 символами.
# Смена секрета разлогинивает всех.
OAUTH_COOKIE_SECRET=

# Любые свои переменные тоже уезжают в контейнер и подставляются в
# agent.yaml как ${ИМЯ} — здесь живут пароли к бэкендам из upstream_auth.
# PROM_PASSWORD=
# ADMIN_PASSWORD=
