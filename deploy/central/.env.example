# Скопируйте в .env и заполните. Файл читается docker compose автоматически.

# Версия образа из ghcr.io/wendor/leauth. По умолчанию latest; на боевом
# хосте лучше закрепить релиз, чтобы перезапуск не подтянул новую версию.
# LEAUTH_TAG=v1.0.0

# Зона, делегированная на этот хост двумя записями у вашего DNS-провайдера.
ACMEDNS_ZONE=acme.example.com
# Имя NS-сервера из той же делегации.
ACMEDNS_NS_HOST=ns-acme.example.com
# Почта администратора зоны в форме SOA: @ заменяется точкой, а точки
# внутри имени ящика экранируются обратным слешем. Примеры:
#   hostmaster@example.com  -> hostmaster.example.com
#   a.ivanov@example.com    -> a\.ivanov.example.com
# Поле декоративное: Let's Encrypt его не читает. Адрес без точек в имени
# ящика избавляет от экранирования.
ACMEDNS_ADMIN=hostmaster.example.com
# Публичный IP этого хоста — тот, что стоит в A-записи NS-сервера.
ACMEDNS_PUBLIC_IP=203.0.113.10
# Адрес, на котором acme-dns слушает 53-й порт. Пустое значение (все
# адреса) не подходит хостам с systemd-resolved: он уже держит
# 127.0.0.53:53. Впишите публичный адрес — конфликта не будет.
# ACMEDNS_BIND_IP=203.0.113.10
# Адрес, который acme-dns слушает внутри контейнера. Менять нужно только
# вместе с network_mode: host — тогда 0.0.0.0 столкнётся с systemd-resolved,
# и сюда вписывается тот же публичный адрес с портом.
# ACMEDNS_LISTEN=203.0.113.10:53

# Адрес, на котором публикуется API центра. По умолчанию все адреса.
# Когда перед центром встал прокси с TLS, поставьте 127.0.0.1: снаружи
# останется только HTTPS, а открытый порт увидит лишь тот же хост.
# LEAUTH_BIND_IP=127.0.0.1

# openssl rand -hex 32 — потеря ключа делает приватные ключи в БД нечитаемыми.
LEAUTH_MASTER_KEY=

# Почта для уведомлений Let's Encrypt об истекающих сертификатах.
ACME_EMAIL=hostmaster@example.com

# Пароль к странице статуса (пользователь по умолчанию — admin).
ADMIN_PASSWORD=

# Резолверы, через которые центр проверяет CNAME, и ожидание в lego.
# Значения по умолчанию — 1.1.1.1:53,8.8.8.8:53 и 5m — подходят почти
# всем; менять стоит, если наружу разрешён только свой DNS. Резолверы
# опрашиваются по кругу, поэтому один недоступный выпуск не остановит.
# Порт можно не писать; IPv6 — в скобках: [2001:4860:4860::8888]:53
# PRECHECK_RESOLVER=1.1.1.1:53,8.8.8.8:53
# PROPAGATION_TIMEOUT=5m

# Прочие необязательные настройки центра — этот файл целиком уезжает
# в контейнер, поэтому достаточно дописать их сюда:
# ADMIN_USER=admin
# RENEW_BEFORE=720h
# CHECK_INTERVAL=5m
# LEAUTH_LISTEN=:8080

# Тестовый Let's Encrypt для обкатки: лимиты мягче, сертификаты
# ненастоящие. Раскомментируйте на время проверки схемы.
# ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory

# Общий токен, по которому новые прокси получают персональные.
# openssl rand -hex 32
LEAUTH_ENROLL_TOKEN=
